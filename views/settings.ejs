<!DOCTYPE html>
<html lang="en">
    <%-include("components/header") %>
    <body>
        <%-include("components/navbar") %>

        <main>
            <section class="view__container animation height-70">
                <div class="container">
                    <div class="view flex-column-center">
                        <h1 class="title title-big text-center">
                            <span class="text text-primary view__title"
                                ><%=title %></span
                            >
                        </h1>

                        <div
                            class="view__content flex-between w-100"
                            id="todoContent"
                        >
                            <div
                                class="view__item gradient-border flex-column-center height-340"
                            >
                                <p class="title">Name:</p>
                                <form
                                    class="flex-column-center w-100"
                                    id="nameForm"
                                >
                                    <input
                                        type="text"
                                        placeholder="Write Your Name"
                                        name="name"
                                        value="<%=user.name %>"
                                        required
                                    />
                                    <button class="btn">Save</button>
                                </form>
                            </div>
                            <form
                                class="view__item gradient-border flex-column-center height-340"
                                id="passwordForm"
                            >
                                <p class="title">Change Password:</p>
                                <input
                                    type="password"
                                    placeholder="Write Old Password"
                                    name="oldPassword"
                                    required
                                />
                                <input
                                    type="password"
                                    placeholder="Write New Password"
                                    name="newPassword"
                                    required
                                />
                                <input
                                    type="password"
                                    placeholder="Write Confirm Password"
                                    name="confirmPassword"
                                    required
                                />

                                <button class="btn">Change</button>
                            </form>
                        </div>

                        <button class="btn btn-primary">Delete Account</button>
                    </div>
                </div>
            </section>
        </main>
                <div class="notification__container flex-column" id="notificationContainer"></div>

        <%-include("components/footer") %>
    </body>
</html>
