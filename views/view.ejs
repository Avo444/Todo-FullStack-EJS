<!DOCTYPE html>
<html lang="en">
    <%-include("components/header", {script: "postTodoData"}) %>
    <body>
        <%-include("components/navbar") %>

        <main>  
            <section class="view__container animation height-70">
                <div class="container">
                    <div class="view flex-column">
                        <h1 class="title title-big text-center">Todo: <span class="text text-primary view__title"><%=todo.title%></span></h1>
                        
                        <div class="view__content flex-between w-100" id="todoContent">
                            <div class="view__item gradient-border flex-column-center">
                                <p class="title">Completation:</p>
                                <p class="text" style="color: <%=todo.isDone ? 'green' : 'red' %>"><%=todo.isDone ? "Completed" : "In Process"%></p>
                            </div>
                            <div class="view__item gradient-border flex-column-center">
                                <p class="title">Created At:</p>
                                <p class="text"><%=todo.createdAt %></p>
                            </div>
                            <div class="view__item gradient-border flex-column-center">
                                <p class="title">Updated At:</p>
                                <p class="text"><%=todo.updatedAt ? todo.updatedAt : "Not Updated"%></p>
                            </div>
                        </div>
                    </div>
                </div>    
            </section>
        </main>
        <div class="notification__container flex-column" id="notificationContainer"></div>
        <%-include("components/footer") %>
    </body>
</html>
